{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Quartz": "Warning"
      }
    },
    "WriteTo:ConsoleSink:Args:outputTemplate": "{Timestamp:HH:mm:ss}[{Level:u3}] {Message:l} [{SourceContext}]{NewLine}{Exception}"
  },

  "ConnectionStrings": {
    "Default": "DataSource=../../../../../data/iplocatenet.db"
  }
}
