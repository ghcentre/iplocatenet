{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Quartz": "Warning"
      }
    },
    "WriteTo": {
      "ConsoleSink": {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Verbose",
          "outputTemplate": "{Timestamp:HH:mm:ss}[{Level:u3}] {Message:l}{NewLine}{Exception}"
        }
      },
      "FileSink": {
        "Name": "File",
        "Args": {
          "restrictedToMinimumLevel": "6",
          "path": "/var/log/iplocatenet/updater..log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90
        }
      },
      "DebugSink": {
        "Name": "Debug",
        "Args": {
          "restrictedToMinimumLevel": "6"
        }
      }
    },
    "Enrich": [ "FromLogContext" ]
  },

  "ConnectionStrings": {
    "Default": "DataSource=../../data/iplocatenet.db"
  }
}
